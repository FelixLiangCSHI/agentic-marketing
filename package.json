    "contentworkflow:typecheck": "cd packages/content-workflow && python3 -m mypy",
    "deepseek:test": "cd connectors/llm/deepseek && python3 -m pytest",
    "deepseek:typecheck": "cd connectors/llm/deepseek && python3 -m mypy",
    "jimeng:test": "cd connectors/jimeng && python3 -m pytest",
