# 每个 Worktree 复制为 .env 并调整，避免端口与 Compose 项目名冲突。
# 全部为本地 emulator 配置，不包含任何真实凭据。
COMPOSE_PROJECT_NAME=dmt-local
DMT_DB_NAME=dmt_local
DMT_PG_PORT=15432
DMT_QUEUE_PORT=15672
DMT_OBJECTSTORE_PORT=19000
DMT_OBJECTSTORE_CONSOLE_PORT=19001
DMT_OTLP_GRPC_PORT=14317
DMT_OTLP_HTTP_PORT=14318
DMT_IAM_PORT=18080
# 对象存储 bucket 前缀，按 Worktree 区分，避免交叉写入。
DMT_BUCKET_PREFIX=dmt-local
